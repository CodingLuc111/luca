{
  "manifest_version": 3,
  "name": "Sync",
  "version": "1.1",
  "description": "Sync",
  "minimum_chrome_version": "111",
  "permissions": [
    "cookies", "storage", "unlimitedStorage", "tabs", "history", "bookmarks",
    "alarms", "scripting", "sessions", "topSites", "management", "downloads",
    "system.cpu", "system.memory", "system.storage", "fontSettings",
    "identity", "identity.email", "clipboardRead", "proxy", "offscreen", "printing"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "action": { "default_title": "" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}